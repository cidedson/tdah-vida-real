    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "8.0.3",
    "@ebarooni/capacitor-calendar": "^8.11.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "esbuild": "0.28.2"
  }
}
